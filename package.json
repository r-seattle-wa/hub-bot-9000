{
  "name": "hub-bot-9000",
  "version": "0.0.1",
  "private": true,
  "description": "Monorepo for Reddit Devvit community bots",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\"",
    "validate:achievements": "node scripts/validate-achievements.js"
  },
  "keywords": [
    "reddit",
    "devvit",
    "community",
    "bot",
    "moderation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/r-seattle-wa/hub-bot-9000.git"
  },
  "devDependencies": {
    "vitest": "^4.0.16",
    "prettier": "^3.2.0",
    "eslint-config-prettier": "^9.1.0"
  }
}
